# =====================================================================
# .env.example  —  TEMPLATE ONLY (safe to commit)
# Copy this file to `.env` and fill in real values:
#   Windows CMD:  copy .env.example .env
#   PowerShell:   Copy-Item .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# NEVER commit the real .env file — it is already in .gitignore.
#
# On Render you do NOT use a .env file: every key below is typed into
# Dashboard -> your service -> Environment (or comes from render.yaml).
# =====================================================================

# ===== Django core =====
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# REQUIRED in production: with DEBUG=False the app refuses to start if this
# is empty or still the committed placeholder.
SECRET_KEY=
# True while developing. MUST be False in production.
DEBUG=True
# Comma-separated list of allowed domains (comma, no spaces).
# On Render you can leave this alone — settings.py automatically trusts the
# service's own *.onrender.com hostname. Add it only for a custom domain,
# and keep the onrender.com one until DNS has fully switched over.
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins (WITH https://) whose POST forms are allowed. Also picked
# up automatically from Render's own URL.
CSRF_TRUSTED_ORIGINS=

# ===== Database =====
# The store accepts THREE spellings and uses the first one that is set:
#   1. DATABASE_URL        (recommended — paste the whole Neon string)
#   2. PG* variables       (the spelling Neon's own docs use)
#   3. DB_* variables      (the original local-development spelling)
# With none of them set you get SQLite, which is what you want locally.

# --- SQLite (development default: leave all three sections empty) ---
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# --- 1. PostgreSQL from ONE connection string (Neon / Render / Supabase) ---
# Neon console -> your project -> Connect -> "Pooled connection".
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-amber-meadow-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# The DIRECT (non-pooled) string is the same URL with `-pooler` removed from
# the hostname. build.sh runs `migrate` against it, because PgBouncer's
# transaction pooling makes Django migrations flaky. Optional but advised.
# DIRECT_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-amber-meadow-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- 2. PostgreSQL from Neon's PG* variables (alternative to the above) ---
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGPORT=5432

# --- 3. PostgreSQL from individual DB_* variables ---
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ecommerce_db
# DB_USER=postgres
# DB_PASSWORD=your-strong-password
# DB_HOST=localhost
# DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- PostgreSQL connection tuning (serverless databases) ---
# Managed Postgres requires TLS. 'require' forces it, 'prefer' negotiates.
DB_SSLMODE=require
# Seconds a connection may be reused across requests. Default 0 when the
# host is a pooler (`-pooler`), otherwise 60. Neon suspends idle computes
# after ~5 minutes, so never set this above 300.
# DB_CONN_MAX_AGE=0
# Ping a connection before reusing it; reconnect if it died. Keep on.
# DB_CONN_HEALTH_CHECKS=True
# Named cursors cannot survive PgBouncer transaction pooling. Keep on
# unless you connect directly AND stream very large querysets.
# DB_DISABLE_SERVER_SIDE_CURSORS=True

# ===== Deployment behaviour =====
# true  = build.sh loads the demo catalogue (idempotent, only fills gaps)
# false = leave the database alone
SEED_DEMO_DATA=true
# gunicorn worker processes (used by Procfile / render.yaml).
WEB_CONCURRENCY=2
# Root logger level in production (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO

# ===== Media (user-uploaded files) =====
# Only needed on a paid plan with a persistent Disk attached, so photos
# uploaded through /admin/ survive re-deploys:
# MEDIA_ROOT=/var/data/media
MEDIA_ROOT=

# ===== Email (used by password reset) =====
# Console backend prints outgoing mail in your terminal (dev-friendly) and,
# on Render, into the service logs. Fine for a first launch.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Real SMTP example (Gmail app password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@localhost

# ===== Payment gateways (PHASE 13) =====
# Keys come from the gateway dashboard. NEVER hardcode them in code.
# While both Razorpay values are empty the store uses its built-in TEST
# gateway and PAYMENT_LIVE stays False — no real money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ===== Admin account for a fresh deployment =====
# `python manage.py create_admin` reads these. Idempotent: it creates the
# account once and skips afterwards, so it is safe on every deploy.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
