# =====================================================================
# .env.example  —  TEMPLATE ONLY (safe to commit)
# Copy this file to `.env` and fill in real values:
#   Windows CMD:  copy .env.example .env
#   PowerShell:   Copy-Item .env.example .env
#
# NEVER commit the real .env file — it is already in .gitignore.
# =====================================================================

# ===== Django core =====
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True while developing. MUST be False in production.
DEBUG=True
# Comma-separated list of allowed domains (comma, no spaces).
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Database =====
# --- SQLite (development default) ---
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# --- PostgreSQL (production example — just change these values) ---
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ecommerce_db
# DB_USER=postgres
# DB_PASSWORD=your-strong-password
# DB_HOST=localhost
# DB_PORT=5432
# (then run:  pip install psycopg2-binary)

# ===== Email (used by password reset) =====
# Console backend prints outgoing mail in your terminal (dev-friendly).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Real SMTP example (Gmail):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@localhost

# ===== Payment gateways (PHASE 13) =====
# Keys come from the gateway dashboard. NEVER hardcode them in code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
